# ============================================================
# VCinema — Firebase Configuration Environment Variables
# ============================================================
# Copy this file to .env.local and replace with your real credentials
# obtained from Firebase Console (Project Settings > General > Web Apps).
#
# NEVER commit your actual .env or .env.local file with secrets to Git.

VITE_FIREBASE_API_KEY=your-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional: Set to 'true' to connect to local Firebase Emulators (Auth & Firestore)
VITE_USE_FIREBASE_EMULATOR=false
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=localhost:8080
