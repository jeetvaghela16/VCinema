rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Checks if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: Validates that the requesting user matches the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users Collection: /users/{userId}
    // - Any authenticated user can read other users' profiles (needed for theatre participant avatars & names)
    // - Only the authenticated user can create or update their own user profile document
    // - Enforces that the stored uid matches the authenticated Firebase auth uid
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Default deny rule for all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
